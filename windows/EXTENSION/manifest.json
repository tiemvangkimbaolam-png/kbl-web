{
  "manifest_version": 3,
  "name": "KBL · Windows mới",
  "version": "2.1.1",
  "minimum_chrome_version": "120",
  "description": "Cầu nối chatbox trên Chrome với KBL Windows; phiên đăng nhập giữ trong hồ sơ Chrome.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://*.oaiusercontent.com/*",
    "https://grok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "settings.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
