# Runtime dependencies
node_modules/

# Secrets / environment
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# KBL runtime data - never commit customer/business live data
data/
logs/
tmp/
backups/
deploy-backups/
audit/

# Runtime/generated media
public/uploads/

# Temporary/editor files
*.log
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local archives
*.7z
*.rar
*.tar
*.tar.gz

# KBL V1.3.8: vendored Sharp is required by deterministic poster composer on GitHub/Plesk.
# The generic node_modules/ rule above must not drop this native runtime.
!vendor/
!vendor/sharp/
!vendor/sharp/node_modules/
!vendor/sharp/node_modules/**
