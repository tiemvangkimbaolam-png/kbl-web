# Runtime dependencies
node_modules/

# Secrets / environment
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# KBL runtime data - never commit customer/business live data
data/
logs/
tmp/
backups/
deploy-backups/
audit/

# Runtime/generated media
public/uploads/

# Temporary/editor files
*.log
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local archives
*.7z
*.rar
*.tar
*.tar.gz

# KBL V1.3.7 R1 hotfix: keep the vendored Sharp runtime in GitHub/Plesk.
# The generic node_modules rule above would otherwise remove the native composer binary.
!vendor/sharp/node_modules/
!vendor/sharp/node_modules/**
