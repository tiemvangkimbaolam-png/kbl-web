FROM node:24-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl fuse3 ffmpeg tini util-linux tar gzip \
    && rm -rf /var/lib/apt/lists/*

# Cloudflare's official R2/FUSE pattern uses tigrisfs for the S3-compatible mount.
RUN ARCH="$(uname -m)" \
    && if [ "$ARCH" = "x86_64" ]; then ARCH="amd64"; fi \
    && if [ "$ARCH" = "aarch64" ]; then ARCH="arm64"; fi \
    && VERSION="$(curl -fsSL https://api.github.com/repos/tigrisdata/tigrisfs/releases/latest | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)" \
    && test -n "$VERSION" \
    && curl -fsSL "https://github.com/tigrisdata/tigrisfs/releases/download/${VERSION}/tigrisfs_${VERSION#v}_linux_${ARCH}.tar.gz" -o /tmp/tigrisfs.tar.gz \
    && tar -xzf /tmp/tigrisfs.tar.gz -C /usr/local/bin/ \
    && chmod +x /usr/local/bin/tigrisfs \
    && rm -f /tmp/tigrisfs.tar.gz \
    && tigrisfs --version

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY . .
RUN chmod +x /app/cloudflare-backup/container/entrypoint.sh \
    && mkdir -p /mnt/kbl-r2 /app/public

EXPOSE 3000
ENTRYPOINT ["/usr/bin/tini", "--", "/app/cloudflare-backup/container/entrypoint.sh"]
