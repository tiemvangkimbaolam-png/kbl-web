{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kbl-backup",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-18",
  "vars": {
    "KBL_PRIMARY_ORIGIN_URL": "https://origin.tiemvangkimbaolam.id.vn",
    "KBL_BACKUP_PUBLIC_URL": "https://kbl-backup.tiemvangkimbaolam.workers.dev",
    "KBL_R2_BUCKET_NAME": "kbl-backup-media"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kbl-backup-db",
      "database_id": "d0af07a4-a3b6-4c8a-8294-eb1480df93d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kbl-backup-media"
    }
  ],
  "containers": [
    {
      "class_name": "KblHouse2Container",
      "image": "../Dockerfile.house2",
      "image_build_context": "..",
      "max_instances": 1,
      "instance_type": "standard-1",
      "rollout_step_percentage": 100
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KBL_HOUSE2_APP",
        "class_name": "KblHouse2Container"
      }
    ]
  },
  "migrations": [
    {
      "tag": "house2-full-node-v1",
      "new_sqlite_classes": [
        "KblHouse2Container"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "* * * * *"
    ]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
