# KBL core runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# KBL_DATA_DIR=/absolute/persistent/path/data
KBL_PUBLIC_BASE_URL=https://tiemvangkimbaolam.id.vn
KBL_PUBLISHER_PUBLIC_BASE_URL=https://tiemvangkimbaolam.id.vn

# Required secrets - configure on each server, never commit real values
KBL_ADMIN_TOKEN=CHANGE_ME_MIN_32_CHARS
KBL_SYNC_TOKEN=CHANGE_ME_MIN_32_CHARS
KBL_LOCAL_AI_WORKER_TOKEN=CHANGE_ME_MIN_32_CHARS
KBL_VIDEO_WORKER_TOKEN=CHANGE_ME_MIN_32_CHARS

# AI providers - optional depending on enabled features
KBL_GEMINI_API_KEY=
GEMINI_API_KEY=
KBL_OPENAI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KBL_DEEPSEEK_API_KEY=

# Publisher / integrations - fill only when used
KBL_PUBLISHER_TOKEN_KEY=
KBL_META_APP_ID=
KBL_META_APP_SECRET=
KBL_THREADS_APP_ID=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_SANDBOX=false

# Feature switches can stay at app defaults unless intentionally changed.
